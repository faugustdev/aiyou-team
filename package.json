{
  "name": "@aiyou-dev/team",
  "version": "0.1.13",
  "description": "AI agent teams for aiyou-dev — structured, file-based agent teams with role specialization and quality gates",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faugustdev/aiyou-team.git"
  },
  "bugs": {
    "url": "https://github.com/faugustdev/aiyou-team/issues"
  },
  "homepage": "https://github.com/faugustdev/aiyou-team#readme",
  "main": "./dist/opencode-plugin.mjs",
  "types": "./dist/src/adapters/opencode/plugin.d.ts",
  "bin": {
    "aiyou-team": "bin/aiyou-team.js"
  },
  "exports": {
    ".": "./dist/opencode-plugin.mjs",
    "./server": "./dist/opencode-plugin.mjs"
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "opencode-plugin.mjs"
  ],
  "scripts": {
    "build": "npm run build:rs && npm run build:ts && npm run build:opencode-plugin",
    "build:ts": "tsc -p tsconfig.json",
    "build:rs": "napi build --platform --release --package aiyou-team-napi -o .",
    "build:opencode-plugin": "node ./scripts/build-opencode-plugin.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true}); require('fs').rmSync('aiyou-team-napi.*.node',{recursive:false,force:true})\"",
    "simulate:opencode": "npm run build && node ./simulators/opencode-runtime.mjs",
    "simulate:compact": "npm run build && node ./simulators/opencode-compact-check.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run clean && npm run build",
    "pack:local": "node ./scripts/pack-local.mjs",
    "pack:release": "node ./scripts/pack-release.mjs",
    "smoke:package": "node ./scripts/smoke-packed-package.mjs",
    "release:registry": "node ./scripts/release-registry.mjs --publish",
    "release:registry:dry-run": "node ./scripts/release-registry.mjs --dryRun",
    "setup": "node ./bin/aiyou-team.js setup --with-opencode",
    "install:local:user": "npm run pack:local && node ./bin/aiyou-team.js install --source local --local-tarball ./.artifacts/local/aiyou-team-local.tgz",
    "install:registry:user": "node ./bin/aiyou-team.js install --source registry",
    "update": "node ./bin/aiyou-team.js update",
    "uninstall": "node ./bin/aiyou-team.js uninstall",
    "uninstall:user": "node ./bin/aiyou-team.js uninstall:user",
    "doctor": "node ./bin/aiyou-team.js doctor",
    "version": "node ./bin/aiyou-team.js version",
    "test": "npm run build && node --test tests/**/*.test.mjs"
  },
  "napi": {
    "binaryName": "aiyou-team-napi",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.3",
    "@types/node": "^25.9.5",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.15.10",
    "yaml": "^2.8.2"
  },
  "keywords": [
    "aiyou",
    "ai",
    "agents",
    "teams",
    "orchestration",
    "opencode",
    "mcp"
  ],
  "optionalDependencies": {
    "@aiyou-dev/team-napi-darwin-arm64": "0.1.13",
    "@aiyou-dev/team-napi-darwin-x64": "0.1.13",
    "@aiyou-dev/team-napi-linux-x64-gnu": "0.1.13",
    "@aiyou-dev/team-napi-linux-arm64-gnu": "0.1.13"
  }
}
